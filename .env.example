# QuickServe Environment Configuration Template
# Copy this file to .env and populate with your project credentials:
# cp .env.example .env

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Publishable Client Key (NEVER use service_role key here)
SUPABASE_ANON_KEY=your-anon-publishable-key-here
